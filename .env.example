# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_WEB3FORMS_ACCESS_KEY: Required for the Seller/Cash Buyer lead forms to actually
# email info@crossridgeholdingsllc.com (the site is static on GitHub Pages, so there is
# no backend to send mail). Get a free key at https://web3forms.com by registering that
# inbox, then set this value locally AND as the WEB3FORMS_ACCESS_KEY secret in the GitHub
# repo (Settings > Secrets and variables > Actions) so the deploy workflow can bake it in.
VITE_WEB3FORMS_ACCESS_KEY="MY_WEB3FORMS_ACCESS_KEY"

# VITE_HCAPTCHA_SITE_KEY: Public hCaptcha site key that blocks scripted spam
# submissions on the lead forms. Get one free at https://www.hcaptcha.com,
# then enable hCaptcha on your Web3Forms form and paste the SAME site key
# plus the matching secret key into the Web3Forms dashboard (the secret key
# never goes in this codebase — Web3Forms validates the token server-side).
# Set this locally AND as the HCAPTCHA_SITE_KEY secret in the GitHub repo so
# the deploy workflow can bake it in.
VITE_HCAPTCHA_SITE_KEY="MY_HCAPTCHA_SITE_KEY"
