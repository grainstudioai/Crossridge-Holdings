# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_WEB3FORMS_ACCESS_KEY: Required for the Seller/Cash Buyer lead forms to actually
# email info@crossridgeholdingsllc.com (the site is static on GitHub Pages, so there is
# no backend to send mail). Get a free key at https://web3forms.com by registering that
# inbox, then set this value locally AND as the WEB3FORMS_ACCESS_KEY secret in the GitHub
# repo (Settings > Secrets and variables > Actions) so the deploy workflow can bake it in.
VITE_WEB3FORMS_ACCESS_KEY="MY_WEB3FORMS_ACCESS_KEY"

# VITE_HCAPTCHA_SITE_KEY: OPTIONAL. hCaptcha spam protection on the lead
# forms already works with zero config — Web3Forms' free plan provides a
# shared hCaptcha site key (hardcoded as the default in HCaptchaWidget.tsx),
# and hCaptcha is enabled directly on the Web3Forms dashboard under
# Security Settings > Captcha Protection (no separate hCaptcha account or
# secret key needed). Only set this if you move to a paid Web3Forms plan
# that issues you a dedicated hCaptcha site key.
# VITE_HCAPTCHA_SITE_KEY="MY_HCAPTCHA_SITE_KEY"
